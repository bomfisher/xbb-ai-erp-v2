+import type { ApiEnvelope, SaveItemExtData, SaveItemFormData, SaveItemPayload, SaveItemSectionState } from '../../../components/list/types'
+import { normalizeFormData } from '../../../components/form/formSchema'
+
+export const customerBusinessContext = {
+  corpid: 'demo-corp',
+  userId: '115014265324309213',
+} as const
+
+type CustomerDraftMeta = {
+  draftCode?: string
+  draftTitle?: string
+  updatedTime?: number
+}
+
+type CustomerDraftListItem = {
+  draftCode: string
+  draftTitle?: string
+  customerName?: string
+  customerCode?: string
+  updatedTime?: number
+}
+
+type CustomerDraftDetail = {
+  main?: Record<string, unknown>
+  ext?: SaveItemExtData
+  sectionState?: Partial<SaveItemSectionState>
+  draftMeta?: CustomerDraftMeta
+}
+
+type CustomerDraftSaveResult = {
+  draftCode: string
+}
+
+export type CustomerDrawerMode = 'create' | 'edit'
+
+export async function fetchCustomerCreatePayload(): Promise<SaveItemPayload> {
+  return postCustomerJson<SaveItemPayload>('/erp/v1/customer/addItem', customerBusinessContext)
+}
+
+export async function fetchCustomerUpdatePayload(id: number | string): Promise<SaveItemPayload> {
+  return postCustomerJson<SaveItemPayload>('/erp/v1/customer/updateItem', {
+    ...customerBusinessContext,
+    id,
+  })
+}
+
+export async function saveCustomerDraft(formData: SaveItemFormData, draftMeta: CustomerDraftMeta) {
+  return postCustomerJson<CustomerDraftSaveResult>('/erp/v1/customer/saveDraft', toCustomerSubmitPayload(formData, draftMeta))
+}
+
+export async function saveCustomerAndSubmit(formData: SaveItemFormData, draftMeta: CustomerDraftMeta) {
+  return postCustomerJson('/erp/v1/customer/saveAndSubmit', toCustomerSubmitPayload(formData, draftMeta))
+}
+
+export async function fetchCustomerDraftList() {
+  return postCustomerJson<CustomerDraftListItem[]>('/erp/v1/customer/draftList', customerBusinessContext)
+}
+
+export async function loadCustomerDraft(draftCode: string) {
+  return postCustomerJson<CustomerDraftDetail>('/erp/v1/customer/loadDraft', {
+    ...customerBusinessContext,
+    draftCode,
+  })
+}
+
+export function toCustomerSubmitPayload(formData: SaveItemFormData, draftMeta: CustomerDraftMeta) {
+  return {
+    ...customerBusinessContext,
+    main: { ...formData.main },
+    ext: {
+      contacts: formData.sectionState.contacts === 1 ? compactSectionRows(formData.contacts) : [],
+      addresses: formData.sectionState.addresses === 1 ? compactSectionRows(formData.addresses) : [],
+      bankAccounts: formData.sectionState.bankAccounts === 1 ? compactSectionRows(formData.bankAccounts) : [],
+      invoiceProfiles: formData.sectionState.invoiceProfiles === 1 ? compactSectionRows(formData.invoiceProfiles) : [],
+    },
+    sectionState: {
+      contacts: formData.sectionState.contacts,
+      addresses: formData.sectionState.addresses,
+      bankAccounts: formData.sectionState.bankAccounts,
+      invoiceProfiles: formData.sectionState.invoiceProfiles,
+    },
+    draftMeta: {
+      draftCode: draftMeta.draftCode,
+      draftTitle: draftMeta.draftTitle,
+      updatedTime: draftMeta.updatedTime,
+    },
+  }
+}
+
+export function fromDraftDetail(detail: CustomerDraftDetail): { formData: SaveItemFormData; draftMeta: CustomerDraftMeta } {
+  return {
+    formData: normalizeFormData({
+      main: { ...(detail.main ?? {}) },
+      contacts: detail.ext?.contacts ?? [],
+      addresses: detail.ext?.addresses ?? [],
+      bankAccounts: detail.ext?.bankAccounts ?? [],
+      invoiceProfiles: detail.ext?.invoiceProfiles ?? [],
+      sectionState: detail.sectionState,
+    }),
+    draftMeta: {
+      draftCode: detail.draftMeta?.draftCode,
+      draftTitle: detail.draftMeta?.draftTitle,
+      updatedTime: detail.draftMeta?.updatedTime,
+    },
+  }
+}
+
+export function compactSectionRows(rows: Record<string, unknown>[]) {
+  return rows.filter(row => Object.values(row).some(value => value !== null && value !== undefined && value !== ''))
+}
+
+async function postCustomerJson<T>(url: string, payload: unknown) {
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify(payload),
+  })
+
+  if (!response.ok) {
+    throw new Error(`请求失败：${response.status}`)
+  }
+
+  const result = await response.json() as ApiEnvelope<T>
+  if (result.success === false) {
+    throw new Error(result.message)
+  }
+  return result.data
+}

