<script setup lang="ts">
import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue'
import FormDrawerShell from '../../../components/form/FormDrawerShell.vue'
import DynamicFormSection from '../../../components/form/DynamicFormSection.vue'
import { createDefaultSectionState, normalizeFormData } from '../../../components/form/formSchema'
import type { SaveItemFormData, SaveItemPayload } from '../../../components/list/types'
import {
  fetchCustomerCreatePayload,
  fetchCustomerDraftList,
  fetchCustomerUpdatePayload,
  fromDraftDetail,
  loadCustomerDraft,
  saveCustomerAndSubmit,
  saveCustomerDraft,
} from './customerCreate'
import type { CustomerDrawerMode } from './customerCreate'

const props = withDefaults(defineProps<{
  open: boolean
  mode?: CustomerDrawerMode
  customerId?: number | string
}>(), {
  mode: 'create',
  customerId: undefined,
})

const emit = defineEmits<{
  close: []
  saved: []
}>()

const loading = ref(false)
const loadErrorMessage = ref('')
const actionErrorMessage = ref('')
const payload = ref<SaveItemPayload | null>(null)
const actionLoading = ref(false)
const draftListVisible = ref(false)
const draftListLoading = ref(false)
const draftItems = ref<Array<{ draftCode: string; draftTitle?: string; customerName?: string; customerCode?: string; updatedTime?: number }>>([])
const draftMeta = ref<{ draftCode?: string; draftTitle?: string; updatedTime?: number }>({})
const formData = ref<SaveItemFormData>({
  main: {},
  contacts: [],
  addresses: [],
  bankAccounts: [],
  invoiceProfiles: [],
  sectionState: createDefaultSectionState(),
})

const footerDisabled = computed(() => loading.value || actionLoading.value)
const drawerTitle = computed(() => props.mode === 'edit' ? '客户编辑' : '客户新建')
const drawerDescription = computed(() => props.mode === 'edit' ? '侧开抽屉承载客户编辑表单。' : '侧开抽屉承载客户新建表单。')
const toastTimer = ref<number | null>(null)

function clearToastTimer() {
  if (toastTimer.value !== null) {
    window.clearTimeout(toastTimer.value)
    toastTimer.value = null
  }
}

function hideActionToast() {
  clearToastTimer()
  actionErrorMessage.value = ''
}

function showActionToast(message: string) {
  clearToastTimer()
  actionErrorMessage.value = message
  toastTimer.value = window.setTimeout(() => {
    actionErrorMessage.value = ''
    toastTimer.value = null
  }, 3000)
}

async function loadPayload() {
  loading.value = true
  loadErrorMessage.value = ''
  hideActionToast()
  payload.value = null
  draftMeta.value = {}

  try {
    payload.value = props.mode === 'edit'
      ? await fetchCustomerUpdatePayload(String(props.customerId ?? ''))
      : await fetchCustomerCreatePayload()
    formData.value = normalizeFormData(payload.value.data)
  } catch (error) {
    loadErrorMessage.value = error instanceof Error ? error.message : (props.mode === 'edit' ? '客户编辑页加载失败' : '客户新建页加载失败')
  } finally {
    loading.value = false
  }
}

async function handleSaveDraft() {
  actionLoading.value = true
  hideActionToast()
  try {
    const result = await saveCustomerDraft(formData.value, draftMeta.value)
    draftMeta.value = { ...draftMeta.value, draftCode: result.draftCode }
  } catch (error) {
    showActionToast(error instanceof Error ? error.message : '保存草稿失败')
  } finally {
    actionLoading.value = false
  }
}

async function handleSaveAndSubmit() {
  actionLoading.value = true
  hideActionToast()
  try {
    await saveCustomerAndSubmit(formData.value, draftMeta.value)
    emit('saved')
    emit('close')
  } catch (error) {
    showActionToast(error instanceof Error ? error.message : '正式保存失败')
  } finally {
    actionLoading.value = false
  }
}

async function handleViewDrafts() {
  draftListLoading.value = true
  draftListVisible.value = true
  hideActionToast()
  try {
    draftItems.value = await fetchCustomerDraftList()
  } catch (error) {
    showActionToast(error instanceof Error ? error.message : '草稿列表加载失败')
  } finally {
    draftListLoading.value = false
  }
}

async function handleLoadDraft(draftCode: string) {
  actionLoading.value = true
  hideActionToast()
  try {
    const detail = await loadCustomerDraft(draftCode)
    const loaded = fromDraftDetail(detail)
    formData.value = loaded.formData
    draftMeta.value = loaded.draftMeta
    draftListVisible.value = false
  } catch (error) {
    showActionToast(error instanceof Error ? error.message : '载入草稿失败')
  } finally {
    actionLoading.value = false
  }
}

watch(
  () => props.open,
  open => {
    if (open) {
      void loadPayload()
    } else {
      hideActionToast()
      draftListVisible.value = false
    }
  },
)

onMounted(() => {
  if (props.open) {
    void loadPayload()
  }
})

onBeforeUnmount(() => {
  clearToastTimer()
})
</script>

<template>
  <FormDrawerShell
    :open="open"
    :title="drawerTitle"
    :description="drawerDescription"
    :loading="loading"
    :error-message="loadErrorMessage"
    @close="emit('close')"
  >
    <DynamicFormSection
      v-if="payload"
      :head-list="payload.headList"
      :form-data="formData"
    />

    <template #header-actions>
      <div class="customer-create-drawer__actions">
        <button class="ghost-btn" data-action="view-drafts" :disabled="footerDisabled" type="button" @click="handleViewDrafts">查看草稿</button>
        <button class="ghost-btn" data-action="save-draft" :disabled="footerDisabled" type="button" @click="handleSaveDraft">保存草稿</button>
        <button class="brand-btn" data-action="save-submit" :disabled="footerDisabled" type="button" @click="handleSaveAndSubmit">正式保存</button>

        <div v-if="actionErrorMessage" class="customer-create-drawer__toast" role="alert">
          <span class="customer-create-drawer__toast-message">{{ actionErrorMessage }}</span>
          <button class="customer-create-drawer__toast-close" data-toast-close type="button" @click="hideActionToast">关闭</button>
        </div>
        <div v-if="draftListVisible" class="customer-draft-list">
          <div v-if="draftListLoading" class="customer-draft-list__state">草稿加载中</div>
          <div v-else-if="draftItems.length === 0" class="customer-draft-list__state">暂无草稿</div>
          <ul v-else class="customer-draft-list__items">
            <li v-for="item in draftItems" :key="item.draftCode">
              <button class="customer-draft-list__item" :data-draft-code="item.draftCode" type="button" @click="handleLoadDraft(item.draftCode)">
                <span class="customer-draft-list__title">{{ item.draftTitle ?? item.customerName ?? item.customerCode ?? '未命名草稿' }}</span>
                <span class="customer-draft-list__meta">{{ item.customerCode ?? '未填写编码' }}</span>
              </button>
            </li>
          </ul>
        </div>
      </div>
    </template>
  </FormDrawerShell>
</template>

