+<script setup lang="ts">
+import { onMounted, ref } from 'vue'
+import ListDataTable from '../../../components/list/ListDataTable.vue'
+import ListFilterPanel from '../../../components/list/ListFilterPanel.vue'
+import ListPageFooterActions from '../../../components/list/ListPageFooterActions.vue'
+import ListPageLayout from '../../../components/list/ListPageLayout.vue'
+import ListPagination from '../../../components/list/ListPagination.vue'
+import ListTableHeaderActions from '../../../components/list/ListTableHeaderActions.vue'
+import CustomerCreateDrawer from './CustomerCreateDrawer.vue'
+import type { CustomerDrawerMode } from './customerCreate'
+import type { ApiEnvelope, FilterField, HeaderField, ListButtonItem, ListFilterCondition, ListRowActionItem } from '../../../components/list/types'
+
+type CustomerListItem = {
+  id: number
+  customerCode?: string
+  customerName?: string
+  customerCategory?: string
+  ownerSalesId?: string
+  defaultContactName?: string
+  defaultContactMobile?: string
+  defaultAddressSummary?: string
+  defaultInvoiceTitle?: string
+  bizStatus?: string
+}
+
+type CustomerListResponse = {
+  headList: null
+  list: CustomerListItem[]
+  pageHelper: {
+    page: number
+    count: number
+    hasLeft: boolean
+    hasRight: boolean
+  }
+}
+
+type ListPayload<T> = {
+  list: T[]
+}
+
+const loading = ref(true)
+const errorMessage = ref('')
+const filters = ref<FilterField[]>([])
+const headers = ref<HeaderField[]>([])
+const topButtons = ref<ListButtonItem[]>([])
+const bottomButtons = ref<ListButtonItem[]>([])
+const rowActions = ref<ListRowActionItem[]>([])
+const rows = ref<CustomerListItem[]>([])
+const keyword = ref('')
+const conditions = ref<ListFilterCondition[]>([])
+const pageHelper = ref<CustomerListResponse['pageHelper']>({ page: 1, count: 1, hasLeft: false, hasRight: false })
+const createDrawerOpen = ref(false)
+const drawerMode = ref<CustomerDrawerMode>('create')
+const editingCustomerId = ref<number | string | undefined>(undefined)
+
+const businessContext = {
+  corpid: 'demo-corp',
+  userId: '115014265324309213',
+  businessCode: 'CUSTOMER',
+}
+
+onMounted(async () => {
+  try {
+    const [filterPayload, headerPayload, topButtonPayload, bottomButtonPayload, rowActionPayload] = await Promise.all([
+      postJson<ListPayload<FilterField>>('/erp/v1/common/list/filter', businessContext),
+      postJson<ListPayload<HeaderField>>('/erp/v1/common/list/header', businessContext),
+      postJson<ListPayload<ListButtonItem>>('/erp/v1/common/list/topButton', businessContext),
+      postJson<ListPayload<ListButtonItem>>('/erp/v1/common/list/bottomButton', businessContext),
+      postJson<ListPayload<ListRowActionItem>>('/erp/v1/common/list/rowAction', businessContext),
+    ])
+
+    filters.value = filterPayload.list ?? []
+    headers.value = headerPayload.list ?? []
+    topButtons.value = sortButtons(topButtonPayload.list ?? [])
+    bottomButtons.value = sortButtons(bottomButtonPayload.list ?? [])
+    rowActions.value = sortRowActions(rowActionPayload.list ?? [])
+
+    await loadList()
+  } catch (error) {
+    errorMessage.value = error instanceof Error ? error.message : '客户列表加载失败'
+  } finally {
+    loading.value = false
+  }
+})
+
+async function loadList(page = 1) {
+  const payload = await postJson<CustomerListResponse>('/erp/v1/customer/list', {
+    corpid: businessContext.corpid,
+    userId: businessContext.userId,
+    pageNum: page,
+    pageSize: 20,
+    keyword: keyword.value,
+    conditions: conditions.value,
+  }) as CustomerListResponse
+
+  rows.value = payload.list ?? []
+  pageHelper.value = payload.pageHelper
+}
+
+async function handleSubmit() {
+  await loadList(1)
+}
+
+async function handleReset() {
+  keyword.value = ''
+  conditions.value = []
+  await loadList(1)
+}
+
+function handleKeywordUpdate(value: string) {
+  keyword.value = value
+}
+
+function handleConditionsUpdate(value: ListFilterCondition[]) {
+  conditions.value = value
+}
+
+function renderCell(row: { id: number | string; [key: string]: unknown }, attr: string) {
+  const attrMap: Record<string, keyof CustomerListItem> = {
+    'main.customerCode': 'customerCode',
+    'main.customerName': 'customerName',
+    'main.customerCategory': 'customerCategory',
+    'main.ownerSalesId': 'ownerSalesId',
+    'contacts.contactName': 'defaultContactName',
+    'contacts.mobile': 'defaultContactMobile',
+    'addresses.detailAddress': 'defaultAddressSummary',
+    'invoiceProfiles.invoiceTitle': 'defaultInvoiceTitle',
+    'main.bizStatus': 'bizStatus',
+  }
+  const key = attrMap[attr]
+  return key ? String((row as CustomerListItem)[key] ?? '—') : '—'
+}
+
+function sortButtons(buttons: ListButtonItem[]) {
+  return [...buttons].sort((left, right) => left.sort - right.sort)
+}
+
+function sortRowActions(actions: ListRowActionItem[]) {
+  return [...actions].sort((left, right) => left.sort - right.sort)
+}
+
+function handleHeaderAction(button: ListButtonItem) {
+  if (button.buttonCode === 'ADD' || button.actionCode === 'ADD') {
+    drawerMode.value = 'create'
+    editingCustomerId.value = undefined
+    createDrawerOpen.value = true
+  }
+}
+
+function handleRowAction(payload: { actionCode: string; row: CustomerListItem }) {
+  if (payload.actionCode === 'EDIT') {
+    drawerMode.value = 'edit'
+    editingCustomerId.value = payload.row.id
+    createDrawerOpen.value = true
+  }
+}
+
+function closeCreateDrawer() {
+  createDrawerOpen.value = false
+}
+
+async function handleDrawerSaved() {
+  await loadList(1)
+}
+
+async function postJson<T>(url: string, payload: unknown) {
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify(payload),
+  })
+
+  if (!response.ok) {
+    throw new Error(`请求失败：${response.status}`)
+  }
+
+  const result = await response.json() as ApiEnvelope<T>
+  if (result.success === false) {
+    throw new Error(result.message)
+  }
+  return result.data
+}
+</script>
+
+<template>
+  <section class="customer-list-page">
+    <div v-if="loading" class="menu-workspace__empty">客户列表加载中</div>
+    <div v-else-if="errorMessage" class="menu-workspace__empty">{{ errorMessage }}</div>
+    <ListPageLayout v-else title="客户列表" description="按统一列表页规范展示筛选区、操作区、数据区与分页区。">
+      <template #footer-actions>
+        <ListPageFooterActions :buttons="bottomButtons" />
+      </template>
+
+      <ListFilterPanel
+        :filters="filters"
+        :keyword="keyword"
+        :conditions="conditions"
+        @submit="handleSubmit"
+        @reset="handleReset"
+        @update:keyword="handleKeywordUpdate"
+        @update:conditions="handleConditionsUpdate"
+      />
+
+      <ListDataTable
+        :headers="headers"
+        :rows="rows"
+        :render-cell="renderCell"
+        :row-actions="rowActions"
+        title="客户数据"
+        description="当前按客户主档维度展示列表信息。"
+        @row-action="handleRowAction"
+      >
+        <template #header-actions>
+          <ListTableHeaderActions :buttons="topButtons" @action="handleHeaderAction" />
+        </template>
+      </ListDataTable>
+
+      <ListPagination
+        :page="pageHelper.page"
+        :count="pageHelper.count"
+        :has-left="pageHelper.hasLeft"
+        :has-right="pageHelper.hasRight"
+        @previous="loadList(pageHelper.page - 1)"
+        @next="loadList(pageHelper.page + 1)"
+      />
+    </ListPageLayout>
+
+    <CustomerCreateDrawer
+      :open="createDrawerOpen"
+      :mode="drawerMode"
+      :customer-id="editingCustomerId"
+      @close="closeCreateDrawer"
+      @saved="handleDrawerSaved"
+    />
+  </section>
+</template>

